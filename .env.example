# Use BEDROCK_REGION in Amplify/hosting (names cannot start with AWS_ there).
# For local dev you can set either BEDROCK_REGION or AWS_REGION.
BEDROCK_REGION=us-east-1

# Bedrock RAG
BEDROCK_KNOWLEDGE_BASE_ID=KB12345678
# Generation model: foundation-model ARNs work for on-demand–eligible models (e.g. Haiku below).
# Newer models (e.g. Claude Sonnet 4.5) require an inference profile ARN including your account ID:
#   arn:aws:bedrock:us-east-1:123456789012:inference-profile/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Account: aws sts get-caller-identity --query Account --output text
# Profiles: aws bedrock list-inference-profiles --region us-east-1
BEDROCK_MODEL_ARN=arn:aws:bedrock:us-east-1:123456789012:inference-profile/global.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_GUARDRAIL_ID=gr-12345678
BEDROCK_GUARDRAIL_VERSION=1
BEDROCK_MAX_TOKENS=700

# Cognito (use: terraform output -raw cognito_user_pool_id / cognito_client_id from infra/)
COGNITO_USER_POOL_ID=us-east-1_examplepool
COGNITO_CLIENT_ID=exampleclientid

# DynamoDB (use: terraform output -raw profile_table_name / battles_table_name / messages_table_name from infra/)
DYNAMODB_PROFILE_TABLE=astralchat-profiles
DYNAMODB_BATTLES_TABLE=astralchat-battles
DYNAMODB_MESSAGES_TABLE=astralchat-messages

# Signs extracted PDF text so /api/chat only accepts document context that
# went through the upload scanner. Generate with: openssl rand -hex 32
APP_SECRET=change-me

# App-wide Bedrock request ceiling (requests/minute across all users).
GLOBAL_RATE_LIMIT_PER_MINUTE=120
