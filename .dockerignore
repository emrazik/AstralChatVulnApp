# CRITICAL — never ship credentials, local state, or infra files into an image layer.
.env
.env.*
!.env.example
!.env.docker.example

# Runtime AWS credentials (mounted read-only at run time, never baked in)
.aws-runtime

# VCS / local tooling
.git
.github
.gitignore
.claude
.vscode
.idea

# Build outputs & caches (rebuilt in-container)
node_modules
.next
out
dist
coverage
tsconfig.tsbuildinfo

# Terraform state and vars — server-side only
infra/.terraform
infra/.terraform.lock.hcl
infra/terraform.tfstate*
infra/terraform.tfvars
*.tfstate
*.tfstate.*

# Research scripts, docs and screenshots aren't needed in the image
research
docs

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Docker-related — don't recursively include itself
Dockerfile
.dockerignore
docker-compose*.yml
