# Template for the runtime secrets file used by docker-compose.
# Copy to `.env.docker` on your server and fill in real values.
# `.env.docker` is gitignored — it must NEVER be committed or baked into images.
#
# All values come from your Terraform stack:
#   cd infra && terraform output -raw <name>

# AWS region Bedrock / DynamoDB / Cognito live in.
BEDROCK_REGION=us-east-1

# Bedrock RAG
BEDROCK_KNOWLEDGE_BASE_ID=KB12345678
# Generation model — MUST match `bedrock_generation_model_arn` in infra/terraform.tfvars.
# This model also runs the visual PDF-injection scanner, which uses vision + strict
# instruction-following. Haiku 3 is vision-capable but misjudges blank pages; use
# Sonnet 4.5 or better for reliable scanner behavior.
# Foundation-model ARN (on-demand-eligible models only, e.g. Haiku):
#   arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-3-haiku-20240307-v1:0
# Inference-profile ARN (required for Sonnet 4.5 and other newer models — includes account ID):
#   arn:aws:bedrock:us-east-1:123456789012:inference-profile/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Account: aws sts get-caller-identity --query Account --output text
# Profiles: aws bedrock list-inference-profiles --region us-east-1
BEDROCK_MODEL_ARN=
BEDROCK_GUARDRAIL_ID=gr-12345678
BEDROCK_GUARDRAIL_VERSION=1
BEDROCK_MAX_TOKENS=700

# Cognito (use: terraform output -raw cognito_user_pool_id / cognito_client_id from infra/)
COGNITO_USER_POOL_ID=us-east-1_examplepool
COGNITO_CLIENT_ID=exampleclientid

# DynamoDB (use: terraform output -raw profile_table_name / battles_table_name / messages_table_name from infra/)
DYNAMODB_PROFILE_TABLE=astralchat-profiles
DYNAMODB_BATTLES_TABLE=astralchat-battles
DYNAMODB_MESSAGES_TABLE=astralchat-messages

# AWS credentials for the container process.
# Preferred: attach an IAM role to the host and let the SDK use the
# instance/container metadata — then leave these unset.
# Alternative for non-AWS hosts: uncomment and use a scoped IAM user.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
