# Template for the runtime secrets file used by docker-compose.
# Copy to `.env.docker` on your server and fill in real values.
# `.env.docker` is gitignored — it must NEVER be committed or baked into images.
#
# All values come from your Terraform stack:
#   cd infra && terraform output -raw <name>

# AWS region Bedrock / DynamoDB / Cognito live in.
BEDROCK_REGION=us-east-1

# Bedrock RAG
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_MODEL_ARN=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=1
BEDROCK_MAX_TOKENS=700

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# DynamoDB
DYNAMODB_PROFILE_TABLE=
DYNAMODB_BATTLES_TABLE=
DYNAMODB_MESSAGES_TABLE=

# AWS credentials for the container process.
# Preferred: attach an IAM role to the host and let the SDK use the
# instance/container metadata — then leave these unset.
# Alternative for non-AWS hosts: uncomment and use a scoped IAM user.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
